rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payment proofs: student can upload to their own uid directory; authenticated users and admins can read
    match /paymentProofs/{uid}/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
    }
  }
}
